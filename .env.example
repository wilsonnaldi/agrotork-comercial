# ─────────────────────────────────────────────────────────────
# AGROTORK — Sistema Comercial
# Copie este arquivo para .env.local e preencha.
# NUNCA versione o .env.local. NUNCA cole chaves no código.
# ─────────────────────────────────────────────────────────────

# ── OBRIGATÓRIAS ─────────────────────────────────────────────
# Supabase → Project Settings → API

# URL do projeto. Pública por natureza (vai para o navegador).
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Chave "anon public". TAMBÉM é pública por natureza: ela não dá acesso a
# nada por si só — quem decide o que cada usuário enxerga é o RLS. Não
# confunda com a service role.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"

# ── RECOMENDADA ──────────────────────────────────────────────
# Endereço público da aplicação. Usado como base do link de
# compartilhamento quando o cabeçalho da requisição não bastar.
# Em produção, o domínio real: https://sistema.agrotork.com.br
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── NÃO CONFIGURE AINDA ──────────────────────────────────────
#
#   SUPABASE_SERVICE_ROLE_KEY
#
# Esta chave IGNORA o RLS: quem a tem lê e escreve tudo, em qualquer
# tabela, de qualquer usuário.
#
# Hoje NENHUM código do sistema a utiliza. O cliente que a consumiria
# (`src/lib/supabase/admin.ts`) existe pronto, mas está sem uso: ele só
# será necessário quando o módulo de USUÁRIOS chegar, para criar contas
# no Auth ao convidar um vendedor.
#
# Enquanto isso, a configuração mais segura é a que não tem o segredo:
# uma chave que não está no ambiente não vaza em log, em variável de
# build, nem em captura de tela. Deixe-a de fora até haver código que
# precise dela — e, quando houver, configure-a SOMENTE no servidor
# (nunca com o prefixo NEXT_PUBLIC_).
